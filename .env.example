# Copy to .env.local for local dev, or set these in the Vercel dashboard
# (Project -> Settings -> Environment Variables) for the deployed site.

# Required for photo reading. Without it the app still runs; the camera
# features turn themselves off and say why.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-5.
# claude-sonnet-5 is cheaper per call if you expect heavy traffic.
# CLAUDE_MODEL=claude-opus-5
